<?xml version="1.0" encoding="UTF-8"?>
<!--<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">-->
<suite name="DMVTEK-Retail Application Test Regression Suite" verbose="2"
	thread-count="3" parallel="tests">

	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
	</listeners>


	<test name="Login Page Test">
		<classes>
			<class name="com.qa.retail.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="Accounts Page Test">
		<classes>
			<class name="com.qa.retail.tests.AccountsPageTest" />
		</classes>
	</test>

	<test name="Product Results Page Test">
		<classes>
			<class name="com.qa.retail.tests.ProductResultPageTest" />
		</classes>
	</test>

	<test name="Register Page Test">
		<classes>
			<class name="com.qa.retail.tests.RegisterPageTest" />
		</classes>
	</test>


</suite>